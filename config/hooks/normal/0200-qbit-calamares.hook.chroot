#!/bin/sh
set -e
for d in /etc/calamares/branding /usr/share/calamares/branding; do
    [ -d "$d/debian" ] || continue
    [ -d "$d/qbit" ] && continue
    cp -a "$d/debian" "$d/qbit"
    sed -i -E '/^[[:space:]]*(productName|shortProductName|versionedName|shortVersionedName|bootloaderEntryName):/ s/Debian( GNU\/Linux)?/Qbit Linux/g' "$d/qbit/branding.desc"
    sed -i -E 's/^componentName:.*/componentName:   qbit/' "$d/qbit/branding.desc"
done
if [ -f /etc/calamares/settings.conf ]; then
    sed -i -E 's/^branding:.*/branding: qbit/' /etc/calamares/settings.conf
fi
if [ -f /etc/calamares/modules/bootloader.conf ]; then
    sed -i -E 's/^efiBootloaderId:.*/efiBootloaderId: "qbit"/' /etc/calamares/modules/bootloader.conf
fi
