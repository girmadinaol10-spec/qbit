#!/bin/sh
# Remove the "Nuvole" wallpaper (whatever its folder is called) so only Qbit wallpapers remain.
set -e
for base in /usr/share/wallpapers /usr/share/plasma/wallpapers; do
    [ -d "$base" ] || continue
    for d in "$base"/*; do
        [ -d "$d" ] || continue
        name="$(basename "$d" | tr 'A-Z' 'a-z')"
        case "$name" in qbit-*) continue ;; esac
        if [ "$name" = "nuvole" ] || grep -qis 'nuvole' "$d/metadata.json" "$d/metadata.desktop"; then
            echo "I: removing wallpaper $d"
            rm -rf "$d"
        fi
    done
done
